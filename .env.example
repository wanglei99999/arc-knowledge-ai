# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://arc:arc@localhost:5432/arc_knowledge

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Elasticsearch
ES_URL=http://localhost:9200

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=arc-documents

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Ollama（可选，本地 LLM）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_CONTEXT_WINDOW=8192

# JWT 认证
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 记忆系统（Phase 7）
MEMORY_LAST_N=10
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.6
MEMORY_UPDATE_THRESHOLD=0.9

# OpenTelemetry（trace → Phoenix，UI: http://localhost:6006）
OTEL_ENABLED=false               # 本地调 trace 时置 true（需先 docker compose up -d phoenix）
OTEL_SERVICE_NAME=arc-knowledge-ai
OTLP_ENDPOINT=http://localhost:4317
OTEL_CAPTURE_CONTENT=true        # 内容开关：false 时只记结构（耗时/成败），不记 prompt/文档文本
OTEL_CONTENT_MAX_CHARS=300

# Nacos（可选，本地开发可以不配）
NACOS_SERVER=localhost:8848
NACOS_NAMESPACE=dev

# 应用
APP_ENV=development
LOG_LEVEL=INFO

# HuggingFace / 本地模型
# hf-mirror.com 为国内镜像，无需代理即可访问
HF_ENDPOINT=https://hf-mirror.com
# true：只用本地缓存（生产推荐）；false：允许联网下载（首次下载模型时临时改为 false）
RERANKER_OFFLINE=true
# 留空则从 HuggingFace 拉取；填本地目录路径可跳过网络下载
# RERANKER_MODEL_PATH=/path/to/bge-reranker-v2-m3

# Infinity 推理服务（infinity_rerank provider）
INFINITY_BASE_URL=http://localhost:7997
INFINITY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
